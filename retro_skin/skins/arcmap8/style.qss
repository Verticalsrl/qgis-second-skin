/* Retro Skin - ArcMap 8.x style: Windows 2000, flat Office XP style toolbars */
QWidget { font-family: "Tahoma", "MS Sans Serif", "Arial"; font-size: 8pt; }
QMainWindow, QDialog, QDockWidget, QToolBar, QStatusBar, QMenuBar, QTabWidget::pane {
    background-color: #D4D0C8; color: #000000;
}
QMenuBar { border-bottom: 1px solid #808080; }
QMenuBar::item { background: transparent; padding: 3px 7px; border: 1px solid transparent; }
QMenuBar::item:selected { background: #B6BDD2; border: 1px solid #0A246A; }
QMenuBar::item:pressed { background: #F9F8F7; border: 1px solid #808080; }
QMenu { background-color: #F9F8F7; border: 1px solid #808080; }
QMenu::item { padding: 3px 24px 3px 26px; border: 1px solid transparent; color: #000000; }
QMenu::item:selected { background-color: #B6BDD2; border: 1px solid #0A246A; color: #000000; }
QMenu::item:disabled { color: #A0A0A0; }
QMenu::separator { height: 1px; background: #A6A6A6; margin: 3px 2px 3px 26px; }

/* Flat toolbars: the bevel only appears on mouse hover */
QToolBar { border: none; border-bottom: 1px solid #FFFFFF; spacing: 1px; padding: 1px 2px; }
QToolBar::handle { width: 4px; margin: 3px 2px;
    background: qlineargradient(x1:0, x2:1, stop:0 #808080, stop:0.5 #808080, stop:0.51 #FFFFFF, stop:1 #FFFFFF); }
QToolBar::separator { width: 1px; background: #A6A6A6; margin: 3px 3px; }
QToolButton { background: transparent; border: 1px solid transparent; padding: 2px; }
QToolButton:hover { background-color: #B6BDD2; border: 1px solid #0A246A; }
QToolButton:pressed { background-color: #8592B5; border: 1px solid #0A246A; }
QToolButton:checked { background-color: #D4D5D8; border: 1px solid #0A246A; }
QToolButton:checked:hover { background-color: #8592B5; }

QPushButton {
    background-color: #D4D0C8; color: #000000; padding: 3px 12px; min-width: 64px;
    border-top: 1px solid #FFFFFF; border-left: 1px solid #FFFFFF;
    border-right: 2px solid #404040; border-bottom: 2px solid #404040;
}
QPushButton:pressed { border: 1px solid #404040; padding-left: 13px; padding-top: 4px; }
QPushButton:default { border: 1px solid #000000; border-right: 2px solid #000000; border-bottom: 2px solid #000000; }
QPushButton:disabled { color: #808080; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit, QListView, QTreeView, QTableView {
    background-color: #FFFFFF; color: #000000;
    border-top: 2px solid #808080; border-left: 2px solid #808080;
    border-right: 1px solid #FFFFFF; border-bottom: 1px solid #FFFFFF;
    selection-background-color: #0A246A; selection-color: #FFFFFF;
}
QComboBox::drop-down { width: 16px; background: #D4D0C8;
    border-top: 1px solid #FFFFFF; border-left: 1px solid #FFFFFF;
    border-right: 1px solid #404040; border-bottom: 1px solid #404040; }
QHeaderView::section { background-color: #D4D0C8; padding: 2px 4px;
    border-top: 1px solid #FFFFFF; border-left: 1px solid #FFFFFF;
    border-right: 1px solid #808080; border-bottom: 1px solid #808080; }

/* Panel title bar with Windows 2000 gradient */
QDockWidget { color: #FFFFFF; }
QDockWidget > QWidget { color: #000000; }
QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0A246A, stop:1 #A6CAF0);
    padding: 3px 4px; text-align: left; font-weight: bold;
}

/* White Table Of Contents, Windows blue selection */
QgsLayerTreeView { background-color: #FFFFFF; }
QgsLayerTreeView::item { padding: 1px; }
QgsLayerTreeView::item:selected { background-color: #0A246A; color: #FFFFFF; }

QTabBar::tab { background: #D4D0C8; padding: 3px 10px; margin-right: 1px;
    border-top: 1px solid #FFFFFF; border-left: 1px solid #FFFFFF; border-right: 1px solid #404040; }
QTabBar::tab:selected { margin-bottom: -1px; padding-bottom: 4px; }
QTabBar::tab:!selected { margin-top: 2px; }

QScrollBar:vertical { background: #ECE9E3; width: 16px; margin: 16px 0 16px 0; }
QScrollBar:horizontal { background: #ECE9E3; height: 16px; margin: 0 16px 0 16px; }
QScrollBar::handle { background: #D4D0C8; min-height: 16px; min-width: 16px;
    border-top: 1px solid #FFFFFF; border-left: 1px solid #FFFFFF;
    border-right: 1px solid #404040; border-bottom: 1px solid #404040; }
QScrollBar::add-line, QScrollBar::sub-line { background: #D4D0C8; width: 16px; height: 16px; subcontrol-origin: margin;
    border-top: 1px solid #FFFFFF; border-left: 1px solid #FFFFFF;
    border-right: 1px solid #404040; border-bottom: 1px solid #404040; }
QScrollBar::add-line:vertical { subcontrol-position: bottom; }
QScrollBar::sub-line:vertical { subcontrol-position: top; }
QScrollBar::add-line:horizontal { subcontrol-position: right; }
QScrollBar::sub-line:horizontal { subcontrol-position: left; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QStatusBar::item { border-top: 1px solid #808080; border-left: 1px solid #808080;
    border-right: 1px solid #FFFFFF; border-bottom: 1px solid #FFFFFF; }
QProgressBar { background: #FFFFFF; text-align: center; border: 1px solid #808080; }
QProgressBar::chunk { background-color: #0A246A; width: 7px; margin: 1px; }
QToolTip { background-color: #FFFFE1; color: #000000; border: 1px solid #000000; }
QGroupBox { border: 1px solid #A6A6A6; margin-top: 8px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; color: #0046D5; }

/* Buttons with drop-down menu: room for the arrow */
QToolButton[popupMode="1"] { padding-right: 14px; }
QToolButton::menu-button { width: 12px; border: none; border-left: 1px solid #A6A6A6; background: transparent; }
QToolButton::menu-button:hover { border-left: 1px solid #0A246A; }
QToolButton::menu-arrow { image: url(@SKINS_DIR@/menu_arrow.png); width: 7px; height: 4px; }
QToolButton::menu-arrow:disabled { image: url(@SKINS_DIR@/menu_arrow_disabled.png); }
QToolButton[popupMode="2"] { padding-right: 11px; }
QToolButton::menu-indicator { image: url(@SKINS_DIR@/menu_arrow.png); width: 7px; height: 4px;
    subcontrol-origin: padding; subcontrol-position: bottom right; right: 2px; bottom: 3px; }
